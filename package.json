{
  "name": "nouri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit && tsc --project frontend/tsconfig.json",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "dev": "pnpm build:web && node --env-file-if-exists=.env --import=tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import=tsx src/db/migrate.ts",
    "test:integration": "node --env-file-if-exists=.env --import=tsx --test src/app.integration.test.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
