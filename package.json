{
  "name": "nouri-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit && pnpm --dir frontend typecheck",
    "build:web": "pnpm --dir frontend build",
    "dev:web": "pnpm --dir frontend dev",
    "dev:api": "node --env-file-if-exists=.env --import=tsx src/server.ts",
    "dev": "pnpm build:web && concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "db:migrate": "node --env-file-if-exists=.env --import=tsx src/db/migrate.ts",
    "test:unit": "node --import=tsx --test tests/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import=tsx --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clerk/backend": "3.22.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
