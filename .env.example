DATABASE_URL=postgresql://nouri:nouri@localhost:5432/nouri
# From the Clerk dashboard, API keys page. Use a development instance locally.
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# Optional PEM public key for entirely networkless session verification. Without it, public signing keys
# refresh at most every five minutes; unknown token key ids never trigger extra fetches.
# CLERK_JWT_KEY=
# From the Clerk dashboard's Webhooks page: an endpoint at <origin>/webhooks/clerk subscribed to user.deleted.
# Required when NODE_ENV=production, so deleting a Clerk account always erases that person's records.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace-me
# Comma-separated origins that serve the web app: the Vite dev server and the API's built page.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Optional: Google Health sleep and workout import. Set all four, or none. See docs/wearables-design.md.
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_REDIRECT_URI=http://127.0.0.1:3000/oauth/google-health/callback
# Encrypts provider tokens at rest. Generate with: openssl rand -hex 32
# WEARABLE_TOKEN_KEY=

# Optional: the public origin Claude or ChatGPT reach for the MCP server at /mcp. See docs/mcp-design.md.
# NOURI_PUBLIC_URL=https://nouri.example.com
